[bandit]
# Bandit configuration for SentinelPay pipeline
# Suppressions documented from Day 3 triage — false positives only.

# B311 — random module used for OTP generation
# SUPPRESSED: replaced with secrets.token_hex() in V-APP-08 fix
# Still suppressed here to avoid false positives in legacy test code.
skips = B311

# Paths to exclude from scanning
exclude_dirs = [
    "tests",
    "*/tests/*",
    "*/test_*"
]
